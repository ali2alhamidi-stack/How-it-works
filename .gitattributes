# Cross-platform source and generated assets use the same LF contents.
* text=auto
*.js text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.webmanifest text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.ttf binary
